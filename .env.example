# Balance Record Server — environment
# Keep this file out of version control (see .gitignore).

# ---- Web app ----
BALANCE_HOST=127.0.0.1
BALANCE_PORT=8000
BALANCE_DB=balance.db

# Login password for the web UI. Stored only as a PBKDF2 hash in the DB.
BALANCE_PASSWORD=change-me

# Master key used to encrypt secrets at rest (Supabase keys, etc).
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
BALANCE_SECRET_KEY=GENERATE-WITH-python -c "import secrets;print(secrets.token_urlsafe(48))"

# ---- Serial capture ----
MOXA_DEFAULT_PORT=4001
BURST_GAP_SECONDS=1.5
BALANCE_CODEPAGE=cp1250

# ---- Supabase (optional; can also be set in the UI under Settings) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_TABLE=balance_records
